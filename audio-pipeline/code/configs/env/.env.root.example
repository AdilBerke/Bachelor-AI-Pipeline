YOUTUBE_API_KEY=your_youtube_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-6
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=config/comfyui_ltx2_t2v_distilled.workflow.json
COMFYUI_ROOT=tools/ComfyUI
COMFYUI_MODELS_DIR=tools/ComfyUI/models
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_POLL_SECONDS=2
COMFYUI_FPS=24
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=576
COMFYUI_OUTPUT_PREFIX=lofi-local
COMFYUI_NEGATIVE_PROMPT=low quality, blurry, artifact, text watermark, logo, geometric color blocks
LOCAL_VIDEO_FALLBACK_INTERNAL=false
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_MODEL=gen4_turbo
RUNWAY_RATIO=1280:720
RUNWAY_DURATION_SECONDS=2
RUNWAY_TASK_POLL_SECONDS=4
RUNWAY_TASK_TIMEOUT_SECONDS=300
